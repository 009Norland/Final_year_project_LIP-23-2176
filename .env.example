# KRA-LIP Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to GitHub

# MongoDB Atlas (optional — dashboard works without it using local JSON)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=kra_lip

# Flask API
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Model paths (relative to project root)
CASE_MODEL_PATH=models/case_predictor/xgb_case_model.pkl
DOC_MODEL_PATH=models/document_intelligence/tfidf_svm_doc_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/kra_lip.log
